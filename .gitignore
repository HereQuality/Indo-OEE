# ==============================
# Root .gitignore 
# ==============================

# Node modules (both client & server)
node_modules/
client/node_modules/
server/node_modules/

# Environment files (NEVER commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
server/.env
server/.env.local

# Build outputs
client/dist/
client/build/
server/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/logs/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads (local dev)
server/uploads/*
!server/uploads/.gitkeep

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/

