# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=AI_Inventory_Tool

# ── MongoDB Atlas ─────────────────────────────────
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>
# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_me_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=7

# ── Seed ─────────────────────────────────────────
SEED_ADMIN_PASSWORD=change_me
